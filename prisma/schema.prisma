generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum EvaluationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppealStatus {
  PENDING
  RESOLVED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum ActivityType {
  ACTIVITY
  PRACTICE
}

enum AwardType {
  AWARD
  PUNISHMENT
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  student   Student?
  classes   Class[]  @relation("TeacherClasses")
}

model Class {
  id        String    @id @default(cuid())
  name      String
  grade     String
  teacher   User      @relation("TeacherClasses", fields: [teacherId], references: [id])
  teacherId String
  students  Student[]
}

model Student {
  id          String       @id @default(cuid())
  studentNo   String       @unique
  user        User         @relation(fields: [userId], references: [id])
  userId      String       @unique
  class       Class        @relation(fields: [classId], references: [id])
  classId     String

  scores      Score[]
  activities  Activity[]
  awards      Award[]
  attendances Attendance[]
  evaluations Evaluation[]
}

model Score {
  id        String   @id @default(cuid())
  student   Student  @relation(fields: [studentId], references: [id])
  studentId String
  subject   String
  score     Float
  semester  String
  createdAt DateTime @default(now())
}

model Activity {
  id          String       @id @default(cuid())
  student     Student      @relation(fields: [studentId], references: [id])
  studentId   String
  type        ActivityType
  title       String
  score       Float        @default(0)
  date        DateTime
  createdAt   DateTime     @default(now())
}

model Award {
  id          String    @id @default(cuid())
  student     Student   @relation(fields: [studentId], references: [id])
  studentId   String
  type        AwardType
  description String
  level       String
  date        DateTime
  createdAt   DateTime  @default(now())
}

model Attendance {
  id        String           @id @default(cuid())
  student   Student          @relation(fields: [studentId], references: [id])
  studentId String
  date      DateTime
  status    AttendanceStatus
}

model Evaluation {
  id        String           @id @default(cuid())
  student   Student          @relation(fields: [studentId], references: [id])
  studentId String
  semester  String
  aiScore   Float
  aiReport  String           // JSON string
  status    EvaluationStatus @default(PENDING)
  createdAt DateTime         @default(now())

  appeals   Appeal[]
}

model Appeal {
  id           String       @id @default(cuid())
  evaluation   Evaluation   @relation(fields: [evaluationId], references: [id])
  evaluationId String
  type         String       @default("SCORE") // SCORE / ACTIVITY / ATTENDANCE / OTHER
  reason       String
  description  String?
  expectation  String?
  status       AppealStatus @default(PENDING)
  reply        String?
  createdAt    DateTime     @default(now())

  attachments  AppealAttachment[]
}

model AppealAttachment {
  id        String   @id @default(cuid())
  appeal    Appeal   @relation(fields: [appealId], references: [id], onDelete: Cascade)
  appealId  String
  fileName  String
  filePath  String
  fileSize  Int
  fileType  String
  createdAt DateTime @default(now())
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())
  majors      Major[]
}

model Major {
  id           String     @id @default(cuid())
  name         String
  code         String     @unique
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId String
}
